{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kowboy.se/schemas/applied.v1.json",
  "title": "What a site applied: the body of POST /v1/applied, sent after each page a site pulled",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "datatype": {
            "type": "string",
            "enum": ["property", "agent", "office", "area", "association", "project"]
          },
          "connection_id": {
            "type": "string",
            "minLength": 1
          },
          "remote_id": {
            "type": "string",
            "minLength": 1
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "type": "string",
            "enum": ["applied", "failed"]
          },
          "detail": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": ["datatype", "connection_id", "remote_id", "seq", "result"],
        "additionalProperties": false
      }
    }
  },
  "required": ["items"],
  "additionalProperties": false
}
