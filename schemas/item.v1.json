{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kowboy.se/schemas/item.v1.json",
  "title": "Item envelope returned by GET /v1/changes",
  "type": "object",
  "properties": {
    "datatype": {
      "type": "string",
      "enum": ["property", "agent", "office", "area", "association"],
      "source": "SRS §3 - item identity"
    },
    "connection_id": {
      "type": "string",
      "minLength": 1,
      "source": "SRS §3 - item identity"
    },
    "remote_id": {
      "type": "string",
      "minLength": 1,
      "source": "SRS §3 - item identity"
    },
    "office_id": {
      "type": ["string", "null"],
      "source": "SRS §3 - licensing filter, null for tenant-wide datatypes"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "source": "SRS §3 - the only cursor"
    },
    "deleted": {
      "type": "boolean",
      "source": "SRS §3 - tombstone flag"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "source": "SRS §6 - version of the data shape"
    },
    "content_hash": {
      "type": "string",
      "minLength": 1,
      "source": "SRS §3 - change detection and the subscriber's skip test"
    },
    "remote_updated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "source": "SRS §3 - the CRM's own last-change time"
    },
    "data": {
      "type": ["object", "null"],
      "source": "SRS §6 - the canonical object served to subscribers"
    }
  },
  "required": [
    "datatype",
    "connection_id",
    "remote_id",
    "office_id",
    "seq",
    "deleted",
    "schema_version",
    "content_hash",
    "remote_updated_at",
    "data"
  ],
  "additionalProperties": false
}
