{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kowboy.se/schemas/item.v1.json",
  "title": "Item envelope returned by GET /v1/changes",
  "type": "object",
  "properties": {
    "datatype": {
      "type": "string",
      "enum": ["property", "agent", "office", "area", "association"]
    },
    "connection_id": { "type": "string", "minLength": 1 },
    "remote_id": { "type": "string", "minLength": 1 },
    "office_id": { "type": ["string", "null"] },
    "seq": { "type": "integer", "minimum": 1 },
    "deleted": { "type": "boolean" },
    "schema_version": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 1 },
    "remote_updated_at": { "type": ["string", "null"], "format": "date-time" },
    "data": { "type": ["object", "null"] }
  },
  "required": [
    "datatype",
    "connection_id",
    "remote_id",
    "office_id",
    "seq",
    "deleted",
    "schema_version",
    "content_hash",
    "remote_updated_at",
    "data"
  ],
  "additionalProperties": false
}
