{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kowboy.se/schemas/office.v1.json",
  "title": "office.data",
  "type": "object",
  "properties": {
    "id": { "$ref": "_shared.v1.json#/$defs/id" },
    "name": { "type": "string" },
    "address": { "$ref": "_shared.v1.json#/$defs/address" },
    "lat": { "$ref": "_shared.v1.json#/$defs/latitude" },
    "lng": { "$ref": "_shared.v1.json#/$defs/longitude" },
    "phone": { "$ref": "_shared.v1.json#/$defs/nullableString" },
    "email": { "$ref": "_shared.v1.json#/$defs/nullableString" },
    "display": { "$ref": "_shared.v1.json#/$defs/display" },
    "provider_extras": { "$ref": "_shared.v1.json#/$defs/providerExtras" }
  },
  "required": [
    "id",
    "name",
    "address",
    "lat",
    "lng",
    "phone",
    "email",
    "display",
    "provider_extras"
  ],
  "additionalProperties": false
}
