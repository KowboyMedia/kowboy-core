{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kowboy.se/schemas/_shared.v1.json",
  "title": "Shared definitions",
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "timestamp": {
      "description": "RFC 3339, UTC.",
      "type": ["string", "null"],
      "format": "date-time"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": { "$ref": "#/$defs/nullableString" },
        "city": { "$ref": "#/$defs/nullableString" },
        "postal_code": { "$ref": "#/$defs/nullableString" }
      },
      "required": ["street", "city", "postal_code"],
      "additionalProperties": false
    },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "display": {
      "description": "Human-readable strings computed by Core. Additive at any time.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "providerExtras": {
      "description": "Provider-only fields, keyed by provider. Excluded from content_hash.",
      "type": "object",
      "additionalProperties": { "type": "object" }
    }
  }
}
