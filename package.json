{
  "name": "kowboy-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r schemas dist/ && cp -r engine/storage/migrations dist/engine/storage/ && npm run build:panel",
    "build:panel": "vite build --config panel/vite.config.ts",
    "check": "npm run typecheck && npm run check:seam && npm run check:tests && npm run check:secrets && npm run build && npm run test",
    "check:register": "node scripts/check-register.mjs",
    "check:seam": "node scripts/check-seam.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:tests": "node scripts/check-no-skipped-tests.mjs",
    "dev:panel": "vite --config panel/vite.config.ts",
    "dev:web": "node --env-file-if-exists=.env --experimental-strip-types main.ts web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && npm run lint:deno",
    "lint:deno": "deno lint --config clients/lovable-kit/supabase/functions/core-sync/deno.json clients/lovable-kit/supabase/functions/core-sync",
    "report": "node scripts/acceptance-report.mjs",
    "start:web": "node --env-file-if-exists=.env dist/main.js web",
    "start:worker": "node --env-file-if-exists=.env dist/main.js worker",
    "test": "vitest run",
    "test:journeys:wordpress": "playwright test --config clients/wordpress/playwright.config.ts",
    "test:wordpress": "vitest run --config vitest.wordpress.config.ts",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p panel/tsconfig.json --noEmit && npm run typecheck:deno",
    "typecheck:deno": "deno check --config clients/lovable-kit/supabase/functions/core-sync/deno.json clients/lovable-kit/supabase/functions/core-sync/index.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.75.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@tabler/core": "^1.6.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "deno": "^2.9.6",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.3.0",
    "vitest": "^2.1.8"
  }
}
