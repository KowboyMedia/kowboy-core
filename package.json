{
  "name": "kowboy-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r schemas dist/ && cp -r engine/storage/migrations dist/engine/storage/ && vite build --config admin/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin/tsconfig.json && tsc -p admin/tsconfig.e2e.json && npm run typecheck:deno",
    "typecheck:deno": "deno check --config clients/lovable-kit/supabase/functions/core-sync/deno.json clients/lovable-kit/supabase/functions/core-sync/index.ts",
    "test": "vitest run",
    "test:wordpress": "vitest run --config vitest.wordpress.config.ts",
    "lint": "eslint . && npm run lint:deno",
    "lint:deno": "deno lint --config clients/lovable-kit/supabase/functions/core-sync/deno.json clients/lovable-kit/supabase/functions/core-sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:seam": "node scripts/check-seam.mjs",
    "check:tests": "node scripts/check-no-skipped-tests.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm run check:seam && npm run check:tests && npm run check:secrets && npm run build && npm run test && npm run test:e2e",
    "start:web": "node --env-file-if-exists=.env dist/main.js web",
    "start:worker": "node --env-file-if-exists=.env dist/main.js worker",
    "dev:web": "node --env-file-if-exists=.env --experimental-strip-types main.ts web",
    "report": "node scripts/acceptance-report.mjs",
    "dev:admin": "vite --config admin/vite.config.ts",
    "test:e2e": "playwright test --config admin/playwright.config.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.75.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "deno": "^2.9.6",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "lucide-react": "^1.47.0",
    "prettier": "^3.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.6",
    "vitest": "^2.1.8",
    "zod": "^4.6.5"
  }
}
