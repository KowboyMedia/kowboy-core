# Warnings only (strategy §3.2): CI reports findings and never blocks on them.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    # The lowest PHP the plugin runs on (question 99, 2026-09-28): the analysis holds the code to it.
    phpVersion: 80200
    level: 6
    paths:
        - core-client
        - themes
        - test
    excludePaths:
        analyse:
            - core-client/lib
    scanDirectories:
        - core-client/lib/action-scheduler
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
