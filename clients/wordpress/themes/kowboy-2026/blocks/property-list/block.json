{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kowboy/property-list",
  "title": "Bostadslista",
  "description": "Bostäderna från Kowboy Core som kort, tre i bredd, med statusflikar, filter och Visa fler; från alla eller bara från valda mäklare, områden och kontor.",
  "category": "kowboy",
  "icon": "grid-view",
  "editorScript": "core-client-editor",
  "render": "file:./render.php",
  "coreClientList": "property",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "background": {
      "type": "string",
      "default": "white",
      "control": "select",
      "label": "Bakgrund",
      "options": {
        "white": "Vit",
        "subtle": "Ljusbeige"
      }
    }
  }
}
